generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilAcesso {
  coordenacao
  veterinario
  agente
  recepcao
}

enum StatusSolicitacao {
  pendente
  aceita
  recusada
}

enum SetorBaia {
  canil
  gatil
  quarentena
}

enum TipoBaia {
  coletiva
  individual
}

enum EstadoBaia {
  ativa
  inativa
  interditada
  em_higienizacao
}

enum EspecieAnimal {
  cao
  gato
}

enum TipoRacaAnimal {
  catalogo
  srd
  outra
  nao_informada
  personalizada
}

enum SexoAnimal {
  macho
  femea
  nao_informado
}

enum PorteAnimal {
  pequeno
  medio
  grande
  nao_informado
}

enum SituacaoAnimal {
  em_tratamento
  em_quarentena_observacao
  saudavel
  adotado
  obito
}

enum StatusCastracaoAnimal {
  sim
  nao
  nao_informado
}

enum UnidadeIdadeAnimal {
  dias
  meses
  anos
}

enum TipoEventoAnimal {
  criacao
  edicao
  acolhimento
  mudanca_situacao
  mudanca_baia
  pesagem
  observacao
  foto
  exame
  diagnostico
  revogacao_situacao_terminal
}

model Usuario {
  id           Int          @id @default(autoincrement())
  nome         String
  email        String
  senhaHash    String
  cpf          String
  telefone     String?
  perfilAcesso PerfilAcesso
  ativo        Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  funcionario           Funcionario?
  refreshTokens         RefreshToken[]
  solicitacoesDecididas Solicitacao[]      @relation("SolicitacaoDecisor")
  auditoriaEventos      AuditoriaEvento[]
  animaisCriados        Animal[]           @relation("AnimalCriador")
  pesagensAnimais       PesagemAnimal[]
  observacoesAnimais    ObservacaoAnimal[]
  eventosAnimais        EventoAnimal[]

  @@map("usuarios")
}

model Funcionario {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique
  matricula String
  cargo     String
  crmv      String?
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("funcionarios")
}

model Solicitacao {
  id               Int               @id @default(autoincrement())
  nome             String
  cpf              String
  matricula        String
  email            String
  funcaoPretendida PerfilAcesso
  crmv             String?
  senhaHash        String
  status           StatusSolicitacao @default(pendente)
  motivo           String?
  decididoPorId    Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  decididoPor Usuario? @relation("SolicitacaoDecisor", fields: [decididoPorId], references: [id], onDelete: SetNull)

  @@map("solicitacoes")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditoriaEvento {
  id        Int      @id @default(autoincrement())
  tipo      String
  dados     Json?
  usuarioId Int?
  createdAt DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("auditoria_eventos")
}

model Baia {
  id                   Int        @id @default(autoincrement())
  codigo               String
  codigoNormalizado    String     @unique
  setor                SetorBaia
  tipo                 TipoBaia
  capacidade           Int
  areaM2               Decimal?   @db.Decimal(8, 2)
  possuiSolario        Boolean    @default(false)
  exclusivaIsolamento  Boolean    @default(false)
  estado               EstadoBaia @default(ativa)
  ultimaHigienizacaoEm DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  animais Animal[]

  @@index([setor, estado])
  @@map("baias")
}

model RacaAnimal {
  id              Int            @id @default(autoincrement())
  especie         EspecieAnimal
  nome            String
  nomeNormalizado String
  tipo            TipoRacaAnimal @default(personalizada)
  catalogoPadrao  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  animais Animal[]

  @@unique([especie, nomeNormalizado])
  @@index([especie, tipo])
  @@map("racas_animais")
}

model Animal {
  id                        Int                   @id @default(autoincrement())
  nome                      String
  numeroRegistro            String
  numeroRegistroNormalizado String                @unique
  especie                   EspecieAnimal
  racaId                    Int?
  sexo                      SexoAnimal            @default(nao_informado)
  porte                     PorteAnimal           @default(nao_informado)
  corPelagem                String?
  situacao                  SituacaoAnimal        @default(em_tratamento)
  emIsolamento              Boolean               @default(false)
  castrado                  StatusCastracaoAnimal @default(nao_informado)
  pesoAtualKg               Decimal?              @db.Decimal(7, 3)
  dataAcolhimento           DateTime?
  dataNascimento            DateTime?
  idadeEstimadaQuantidade   Int?
  idadeEstimadaUnidade      UnidadeIdadeAnimal?
  idadeAproximada           Boolean               @default(false)
  nasceuNoCcz               Boolean               @default(false)
  baiaId                    Int?
  criadoPorId               Int?
  acolhidoPor               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  raca        RacaAnimal?        @relation(fields: [racaId], references: [id], onDelete: SetNull)
  baia        Baia?              @relation(fields: [baiaId], references: [id], onDelete: SetNull)
  criadoPor   Usuario?           @relation("AnimalCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  fotos       FotoAnimal[]
  pesagens    PesagemAnimal[]
  observacoes ObservacaoAnimal[]
  eventos     EventoAnimal[]

  @@index([especie, situacao])
  @@index([baiaId])
  @@index([racaId])
  @@map("animais")
}

model FotoAnimal {
  id              Int      @id @default(autoincrement())
  animalId        Int
  caminhoAbsoluto String
  nomeArquivo     String
  mimeType        String
  tamanhoBytes    Int
  largura         Int
  altura          Int
  identificacao   Boolean  @default(false)
  ordem           Int      @default(0)
  createdAt       DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, ordem])
  @@map("fotos_animais")
}

model PesagemAnimal {
  id         Int      @id @default(autoincrement())
  animalId   Int
  valorKg    Decimal  @db.Decimal(7, 3)
  observacao String?
  usuarioId  Int?
  createdAt  DateTime @default(now())

  animal  Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([animalId, createdAt])
  @@map("pesagens_animais")
}

model ObservacaoAnimal {
  id                 Int      @id @default(autoincrement())
  animalId           Int
  texto              String
  usuarioId          Int?
  observacaoOrigemId Int?
  createdAt          DateTime @default(now())

  animal           Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  usuario          Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  observacaoOrigem ObservacaoAnimal?  @relation("CorrecoesObservacaoAnimal", fields: [observacaoOrigemId], references: [id], onDelete: SetNull)
  correcoes        ObservacaoAnimal[] @relation("CorrecoesObservacaoAnimal")

  @@index([animalId, createdAt])
  @@map("observacoes_animais")
}

model EventoAnimal {
  id        Int              @id @default(autoincrement())
  animalId  Int
  tipo      TipoEventoAnimal
  resumo    String
  dados     Json?
  usuarioId Int?
  createdAt DateTime         @default(now())

  animal  Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([animalId, createdAt])
  @@index([tipo, createdAt])
  @@map("eventos_animais")
}
